local CONFIG = {
    AutoFarm = false,
    Fly      = false,
    NoClip   = false,
    Hitbox   = false,
    FlySpeed = 120,
    FarmDist = 350,
    HoverHeight = 6,
    HitboxSize  = 60,
}

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local player     = Players.LocalPlayer
if not player then return warn("[mento] no LocalPlayer, bailing") end

local FLY_BIND   = "MentoHubFlyStep"
local uiConns    = {}
local vel        = Vector3.zero
local gui, mainFrame
local origSizes  = {}

-- UI BUILDER ---------------------------------------------------------
local function createToggle(name, text, layoutOrder)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 40)
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    btn.Text = text .. " : OFF"
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.BorderSizePixel = 0
    btn.LayoutOrder = layoutOrder
    btn.Parent = mainFrame
    
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    local function toggle()
        CONFIG[name] = not CONFIG[name]
        btn.Text = text .. " : " .. (CONFIG[name] and "ON" or "OFF")
        btn.BackgroundColor3 = CONFIG[name] and Color3.fromRGB(50, 150, 50) or Color3.fromRGB(40, 40, 50)
        btn.TextColor3 = CONFIG[name] and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(200, 200, 200)
        return CONFIG[name]
    end
    
    table.insert(uiConns, btn.MouseButton1Click:Connect(toggle))
    return btn
end

