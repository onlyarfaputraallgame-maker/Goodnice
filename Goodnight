-- HITBOX -------------------------------------------------------------
local function applyHitbox()
    local char = player.Character
    if not char then return end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            local handle = tool:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") then
                if CONFIG.Hitbox then
                    if not origSizes[handle] then origSizes[handle] = handle.Size end
                    handle.Size = Vector3.new(CONFIG.HitboxSize, CONFIG.HitboxSize, CONFIG.HitboxSize)
                    handle.Transparency = 0.7
                else
                    if origSizes[handle] then
                        handle.Size = origSizes[handle]
                        handle.Transparency = 0
                        origSizes[handle] = nil
                    end
                end
            end
        end
    end
end

-- CORE LOOPS ---------------------------------------------------------
local function flyStep(dt)
    if not CONFIG.Fly then return end
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    
    hum.PlatformStand = true
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    local move = hum.MoveDirection
    local cam = workspace.CurrentCamera
    if cam then
        local look = cam.CFrame.LookVector
        move += Vector3.new(0, look.Y, 0) * 2
    end

    if move.Magnitude > 0 then
        move = move.Unit * CONFIG.FlySpeed
    end
    
    vel = vel:Lerp(move, math.clamp(dt * 10, 0, 1))
    hrp.CFrame = hrp.CFrame + vel * dt
end

-- MAIN FARM LOOP (OVERHEAD) ------------------------------------------
task.spawn(function()
    while task.wait(0.15) do
        if CONFIG.AutoFarm then
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            
            if hrp and hum then
                -- Scan for closest NPC
                local bestTarget, bestHrp = nil, nil
                local bestDist = CONFIG.FarmDist

                for _, v in pairs(workspace:GetChildren()) do
                    if v:IsA("Model") and v ~= char and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") then
                        local h = v.Humanoid
                        local r = v.HumanoidRootPart
                        if h.Health > 0 and not Players:GetPlayerFromCharacter(v) then
                            local d = (hrp.Position - r.Position).Magnitude
                            if d < bestDist then
                                bestDist = d
                                bestTarget = v
                                bestHrp = r
                            end
                        end
                    end
                end

                if bestTarget and bestHrp then
                    -- FREEZE PLAYER & TELEPORT ABOVE HEAD
                    hum.PlatformStand = true
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                    
                    hrp.CFrame = bestHrp.CFrame * CFrame.new(0, CONFIG.HoverHeight, 0)
                    
                    -- Wait a frame for server to register position
                    task.wait(0.05)
                    
                    -- Hit
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then 
                        pcall(function() tool:Activate() end) 
                    end
                    
                    if firetouchinterest then
                        pcall(firetouchinterest, hrp, bestHrp, 0)
                        task.wait(0.01)
                        pcall(firetouchinterest, hrp, bestHrp, 1)
                    end
                end
            end
        else
            -- Restore gravity if AutoFarm is off and Fly is off
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and not CONFIG.Fly then
                hum.PlatformStand = false
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    local char = player.Character
    if not char then return end
    
    if CONFIG.NoClip then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
    
    applyHitbox()
end)

buildUI()
RunService:BindToRenderStep(FLY_BIND, Enum.RenderPriority.Camera.Value + 1, flyStep)

-- UNLOAD -------------------------------------------------------------
local function unload()
    RunService:UnbindFromRenderStep(FLY_BIND)
    for _, c in ipairs(uiConns) do c:Disconnect() end
    table.clear(uiConns)
    if gui then gui:Destroy() end
    CONFIG.AutoFarm, CONFIG.Fly, CONFIG.NoClip, CONFIG.Hitbox = false, false, false, false
    
    local char = player.Character
    if char then
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                local handle = tool:FindFirstChild("Handle")
                if handle and origSizes[handle] then
                    handle.Size = origSizes[handle]
                    handle.Transparency = 0
                end
            end
        end
    end
    table.clear(origSizes)

    if getgenv().MentoFarmUnload == unload then getgenv().MentoFarmUnload = nil end
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = false end
    print("[mento] head farmer unloaded")
end
getgenv().MentoFarmUnload = unload

print("[mento] head farmer loaded :: fixed overhead freeze")
